<?xml version="1.0" encoding="utf-8"?>
<!-- Lets each paired PC appear as its own icon in the top row of the share sheet. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="dev.dropcopy.ShareActivity">
        <data android:mimeType="*/*" />
        <category android:name="dev.dropcopy.category.PC" />
    </share-target>
</shortcuts>
