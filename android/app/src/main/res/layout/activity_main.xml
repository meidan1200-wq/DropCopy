<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="20dp"
        android:paddingEnd="18dp"
        android:paddingBottom="28dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="DropCopy"
                android:textColor="@color/text"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Update available -->
        <LinearLayout
            android:id="@+id/update_card"
            style="@style/Card"
            android:visibility="gone">

            <TextView
                android:id="@+id/update_title"
                style="@style/Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/update_notes"
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="4" />

            <Button
                android:id="@+id/update_install"
                style="@style/Btn.Primary"
                android:layout_width="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Install update" />
        </LinearLayout>

        <!-- Connection -->
        <LinearLayout
            android:id="@+id/status_card"
            style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/status_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="12dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/dot" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/pc_name"
                        style="@style/Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/pc_detail"
                        style="@style/Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/status_message"
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/scan"
                    style="@style/Btn.Primary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="Scan pairing code" />

                <Button
                    android:id="@+id/check"
                    style="@style/Btn.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Check" />
            </LinearLayout>

            <Button
                android:id="@+id/paste_toggle"
                style="@style/Btn.Text"
                android:layout_width="wrap_content"
                android:layout_marginStart="-12dp"
                android:layout_marginTop="6dp"
                android:text="Paste a pairing link instead" />

            <Button
                android:id="@+id/pc_setup"
                style="@style/Btn.Text"
                android:layout_width="wrap_content"
                android:layout_marginStart="-12dp"
                android:text="No DropCopy on your PC yet?" />

            <LinearLayout
                android:id="@+id/paste_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <EditText
                    android:id="@+id/link"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:hint="dropcopy://pair?..."
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:textColor="@color/text"
                    android:textColorHint="@color/idle"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/pair"
                    style="@style/Btn.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Pair" />
            </LinearLayout>
        </LinearLayout>

        <!-- Settings Android needs the user to tap; each row shows only while it is missing. -->
        <LinearLayout
            android:id="@+id/needs_card"
            style="@style/Card"
            android:paddingTop="14dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/needs_title"
                style="@style/Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Needs your OK on this phone"
                android:textColor="@color/warn" />

            <ImageView
                android:id="@+id/row_ok_battery_div"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:importantForAccessibility="no"
                android:src="@drawable/divider" />

            <LinearLayout
                android:id="@+id/row_ok_battery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="72dp"
                android:orientation="horizontal"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Keep working when closed" />

                    <TextView
                        style="@style/Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Battery saving stops DropCopy once you leave the app. Tap Allow, then Allow again." />
                </LinearLayout>

                <Button
                    android:id="@+id/battery_allow"
                    style="@style/Btn.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Allow" />
            </LinearLayout>

            <ImageView
                android:id="@+id/row_ok_oem_div"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:importantForAccessibility="no"
                android:src="@drawable/divider" />

            <LinearLayout
                android:id="@+id/row_ok_oem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="72dp"
                android:orientation="horizontal"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/oem_title"
                        android:text="Let it start on its own" />

                    <TextView
                        style="@style/Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:id="@+id/oem_detail"
                        android:text="" />
                </LinearLayout>

                <Button
                    android:id="@+id/oem_allow"
                    style="@style/Btn.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Open" />
            </LinearLayout>

            <ImageView
                android:id="@+id/row_ok_notify_div"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:importantForAccessibility="no"
                android:src="@drawable/divider" />

            <LinearLayout
                android:id="@+id/row_ok_notify"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="72dp"
                android:orientation="horizontal"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Show its notifications" />

                    <TextView
                        style="@style/Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Android needs this to keep DropCopy running and to tell you about updates." />
                </LinearLayout>

                <Button
                    android:id="@+id/notify_allow"
                    style="@style/Btn.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Allow" />
            </LinearLayout>

            <ImageView
                android:id="@+id/row_ok_photos_div"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:importantForAccessibility="no"
                android:src="@drawable/divider" />

            <LinearLayout
                android:id="@+id/row_ok_photos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="72dp"
                android:orientation="horizontal"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Allow all photos" />

                    <TextView
                        style="@style/Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="It can only see photos you picked, so new screenshots don't reach the PC." />
                </LinearLayout>

                <Button
                    android:id="@+id/photos_allow"
                    style="@style/Btn.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Allow" />
            </LinearLayout>

            <ImageView
                android:id="@+id/row_ok_install_div"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:importantForAccessibility="no"
                android:src="@drawable/divider" />

            <LinearLayout
                android:id="@+id/row_ok_install"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="72dp"
                android:orientation="horizontal"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Let updates install" />

                    <TextView
                        style="@style/Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Android asks once. Turn on “Allow from this source”, then come back." />
                </LinearLayout>

                <Button
                    android:id="@+id/install_allow"
                    style="@style/Btn.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Open" />
            </LinearLayout>

            <ImageView
                android:id="@+id/row_ok_overlay_div"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:importantForAccessibility="no"
                android:src="@drawable/divider" />

            <LinearLayout
                android:id="@+id/row_ok_overlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="72dp"
                android:orientation="horizontal"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Show pictures as they arrive" />

                    <TextView
                        style="@style/Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="A picture from another phone warps onto the screen. Turn on “Display over other apps” for DropCopy." />
                </LinearLayout>

                <Button
                    android:id="@+id/overlay_allow"
                    style="@style/Btn.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Open" />
            </LinearLayout>
        </LinearLayout>

        <!-- Phones -->
        <TextView
            style="@style/SectionLabel"
            android:text="Phones" />

        <LinearLayout style="@style/Card">

            <TextView
                android:id="@+id/phones_title"
                style="@style/Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Send to another phone" />

            <TextView
                android:id="@+id/phones_detail"
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Pictures warp from one phone to the other. Both need DropCopy and the same Wi-Fi." />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/phone_code"
                    style="@style/Btn.Tonal"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="Show my code" />

                <Button
                    android:id="@+id/phone_scan"
                    style="@style/Btn.Tonal"
                    android:layout_width="0dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="Scan a phone" />
            </LinearLayout>

            <Button
                android:id="@+id/phones_forget"
                style="@style/Btn.Text"
                android:layout_width="wrap_content"
                android:layout_marginStart="-12dp"
                android:layout_marginTop="6dp"
                android:text="Forget these phones"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Automatic -->
        <TextView
            style="@style/SectionLabel"
            android:text="Automatic" />

        <LinearLayout
            style="@style/Card"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:id="@+id/row_shots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_text"
                android:gravity="center_vertical"
                android:minHeight="72dp"
                android:orientation="horizontal"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Send new screenshots" />

                    <TextView
                        style="@style/Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Take one, and it's on your PC's clipboard" />
                </LinearLayout>

                <Switch
                    android:id="@+id/sw_shots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:thumbTint="@color/switch_thumb"
                    android:trackTint="@color/switch_track" />
            </LinearLayout>

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:importantForAccessibility="no"
                android:src="@drawable/divider" />

            <LinearLayout
                android:id="@+id/row_camera"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_text"
                android:gravity="center_vertical"
                android:minHeight="72dp"
                android:orientation="horizontal"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Send new photos" />

                    <TextView
                        style="@style/Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Pictures you take with the camera" />
                </LinearLayout>

                <Switch
                    android:id="@+id/sw_camera"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:thumbTint="@color/switch_thumb"
                    android:trackTint="@color/switch_track" />
            </LinearLayout>

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:importantForAccessibility="no"
                android:src="@drawable/divider" />

            <LinearLayout
                android:id="@+id/row_receive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_text"
                android:gravity="center_vertical"
                android:minHeight="72dp"
                android:orientation="horizontal"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Receive from your PCs" />

                    <TextView
                        style="@style/Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="On the PC: right-click a file, Send to, DropCopy. It arrives here while the screen is on" />
                </LinearLayout>

                <Switch
                    android:id="@+id/sw_receive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:thumbTint="@color/switch_thumb"
                    android:trackTint="@color/switch_track" />
            </LinearLayout>

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:importantForAccessibility="no"
                android:src="@drawable/divider" />

            <LinearLayout
                android:id="@+id/row_near"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_text"
                android:gravity="center_vertical"
                android:minHeight="72dp"
                android:orientation="horizontal"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Show on PC when near" />

                    <TextView
                        style="@style/Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Hold the phone by your laptop to bring up your newest photo" />
                </LinearLayout>

                <Switch
                    android:id="@+id/sw_near"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:thumbTint="@color/switch_thumb"
                    android:trackTint="@color/switch_track" />
            </LinearLayout>

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:importantForAccessibility="no"
                android:src="@drawable/divider" />

            <LinearLayout
                android:id="@+id/row_delete"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_text"
                android:gravity="center_vertical"
                android:minHeight="72dp"
                android:orientation="horizontal"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Delete from PC after pasting" />

                    <TextView
                        android:id="@+id/delete_detail"
                        style="@style/Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Nothing piles up in Pictures\\DropCopy" />
                </LinearLayout>

                <Switch
                    android:id="@+id/sw_delete"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:thumbTint="@color/switch_thumb"
                    android:trackTint="@color/switch_track" />
            </LinearLayout>

        </LinearLayout>

        <!-- How to send -->
        <TextView
            style="@style/SectionLabel"
            android:text="How to send" />

        <LinearLayout style="@style/Card">

            <TextView
                style="@style/Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Share → DropCopy" />

            <TextView
                style="@style/Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Or tap your PC's own icon at the top of the share sheet. A paired phone has its own icon there too." />

            <TextView
                style="@style/Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Copy, then tap the tile" />

            <TextView
                style="@style/Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Add “Send clipboard” to Quick Settings. It sends text or an image you copied." />

            <TextView
                style="@style/Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="On the PC" />

            <TextView
                style="@style/Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Photos land in Pictures\\DropCopy and on the clipboard: press Ctrl+V. Hold the phone by your laptop and the newest one shows on a little phone above the taskbar, ready to drag into any app." />
        </LinearLayout>

        <!-- App -->
        <TextView
            style="@style/SectionLabel"
            android:text="App" />

        <LinearLayout
            style="@style/Card"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:id="@+id/row_updates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_text"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Install updates automatically" />

                    <TextView
                        style="@style/Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Checked once a day on Wi-Fi" />
                </LinearLayout>

                <Switch
                    android:id="@+id/sw_updates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:thumbTint="@color/switch_thumb"
                    android:trackTint="@color/switch_track" />
            </LinearLayout>

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:importantForAccessibility="no"
                android:src="@drawable/divider" />

            <Button
                android:id="@+id/forget"
                style="@style/Btn.Text"
                android:layout_width="wrap_content"
                android:layout_marginStart="-12dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:text="Forget paired PCs"
                android:textColor="@color/danger" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Nothing leaves your network. Phone and PC need the same Wi-Fi, or the PC on the phone's hotspot."
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
