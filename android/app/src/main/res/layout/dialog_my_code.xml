<?xml version="1.0" encoding="utf-8"?>
<!-- This phone's code, for another phone to scan. Shown only here: it carries this phone's key. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="22dp"
    android:paddingEnd="22dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/code_title"
        style="@style/Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Scan me"
        android:textSize="20sp" />

    <TextView
        style="@style/Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="On the other phone, on the same Wi-Fi, open DropCopy and tap Scan a phone." />

    <ImageView
        android:id="@+id/code_image"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:contentDescription="Pairing code"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/code_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="12dp"
            android:importantForAccessibility="no"
            android:src="@drawable/dot" />

        <TextView
            android:id="@+id/code_status"
            style="@style/Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Waiting for the other phone…" />
    </LinearLayout>

    <Button
        android:id="@+id/code_done"
        style="@style/Btn.Primary"
        android:layout_width="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="16dp"
        android:text="Done" />
</LinearLayout>
