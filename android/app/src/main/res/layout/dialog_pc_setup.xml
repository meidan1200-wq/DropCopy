<?xml version="1.0" encoding="utf-8"?>
<!-- Set up the PC from the phone: the address to open on the PC, and what is happening. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="22dp"
    android:paddingEnd="22dp"
    android:paddingBottom="16dp">

    <TextView
        style="@style/Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Set up your PC"
        android:textSize="20sp" />

    <TextView
        style="@style/Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="On your PC, on the same Wi-Fi, open this address in a browser. The app it downloads is already paired with this phone." />

    <TextView
        android:id="@+id/setup_address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_input"
        android:fontFamily="monospace"
        android:gravity="center"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:textColor="@color/accent"
        android:textIsSelectable="true"
        android:textSize="19sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/setup_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="12dp"
            android:importantForAccessibility="no"
            android:src="@drawable/dot" />

        <TextView
            android:id="@+id/setup_status"
            style="@style/Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Getting the PC app…" />
    </LinearLayout>

    <Button
        android:id="@+id/setup_done"
        style="@style/Btn.Primary"
        android:layout_width="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="16dp"
        android:text="Cancel" />
</LinearLayout>
