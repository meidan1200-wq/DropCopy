<?xml version="1.0" encoding="utf-8"?>
<!-- "Show on PC when near" setup: what it needs, and a live check that the laptop sees the phone. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="22dp"
    android:paddingEnd="22dp"
    android:paddingBottom="16dp">

    <TextView
        style="@style/Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Show on PC when near"
        android:textSize="20sp" />

    <TextView
        style="@style/Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Hold the phone by your laptop and your newest photo pops up there, ready to drag into any app. No Bluetooth pairing needed: the laptop knows this phone by a code only your PC has." />

    <!-- Bluetooth on -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:minHeight="60dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/near_bt_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="14dp"
            android:importantForAccessibility="no"
            android:src="@drawable/dot" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bluetooth" />

            <TextView
                android:id="@+id/near_bt_detail"
                style="@style/Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <Button
            android:id="@+id/near_bt_btn"
            style="@style/Btn.Tonal"
            android:layout_width="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Turn on" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:importantForAccessibility="no"
        android:src="@drawable/divider" />

    <!-- Nearby devices permission -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="60dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/near_perm_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="14dp"
            android:importantForAccessibility="no"
            android:src="@drawable/dot" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nearby devices" />

            <TextView
                android:id="@+id/near_perm_detail"
                style="@style/Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <Button
            android:id="@+id/near_perm_btn"
            style="@style/Btn.Tonal"
            android:layout_width="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Allow" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:importantForAccessibility="no"
        android:src="@drawable/divider" />

    <!-- Photos: it sends the newest one -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="60dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/near_photo_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="14dp"
            android:importantForAccessibility="no"
            android:src="@drawable/dot" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Photos" />

            <TextView
                android:id="@+id/near_photo_detail"
                style="@style/Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <Button
            android:id="@+id/near_photo_btn"
            style="@style/Btn.Tonal"
            android:layout_width="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Allow" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:importantForAccessibility="no"
        android:src="@drawable/divider" />

    <!-- Live check -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="4dp">

        <ImageView
            android:id="@+id/near_seen_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginTop="7dp"
            android:layout_marginEnd="14dp"
            android:importantForAccessibility="no"
            android:src="@drawable/dot" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your laptop" />

            <TextView
                android:id="@+id/near_seen_detail"
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Checking…" />

            <ProgressBar
                android:id="@+id/near_meter"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="10dp"
                android:max="60"
                android:progressBackgroundTint="@color/track_off"
                android:progressTint="@color/accent"
                android:visibility="invisible" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/near_done"
        style="@style/Btn.Primary"
        android:layout_width="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="14dp"
        android:text="Done" />
</LinearLayout>
